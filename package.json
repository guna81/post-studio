{
  "name": "post-studio",
  "version": "0.1.0",
  "description": "Free open-source Instagram carousel generator for Claude Code. Research topics, write slides and captions, render PNGs and export. No API key.",
  "type": "module",
  "bin": {
    "post-studio": "bin/post-studio.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "render": "node formats/carousel/render.mjs",
    "doctor": "node bin/post-studio.mjs doctor",
    "test": "node --test \"**/*.test.mjs\""
  },
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "files": [
    "bin",
    "lib",
    "server.mjs",
    "cli.mjs",
    "formats",
    "channels",
    "ui",
    "skills",
    ".claude-plugin",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "instagram",
    "instagram-carousel",
    "carousel-generator",
    "carousel-maker",
    "social-media",
    "social-media-automation",
    "content-automation",
    "content-creation",
    "ai-content",
    "claude",
    "claude-code",
    "claude-code-plugin",
    "playwright",
    "self-hosted",
    "open-source",
    "no-api-key"
  ],
  "homepage": "https://github.com/guna81/post-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guna81/post-studio.git"
  },
  "bugs": {
    "url": "https://github.com/guna81/post-studio/issues"
  }
}
