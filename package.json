{
  "name": "post-studio",
  "version": "0.1.0",
  "description": "Research topics, draft, render and publish social posts (carousels today, video later) with Claude Code. No API key.",
  "type": "module",
  "bin": {
    "post-studio": "bin/post-studio.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "render": "node formats/carousel/render.mjs",
    "doctor": "node bin/post-studio.mjs doctor"
  },
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "files": [
